# Copiar a .env.local y completar. .env.local NUNCA se commitea.
#
# REGLA: toda variable con prefijo NEXT_PUBLIC_ termina en el bundle del navegador
# y es visible para cualquiera. Un secreto ahi es una filtracion total.

# --- Publicas (van al navegador, esta bien) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Privadas (solo servidor, NUNCA con prefijo NEXT_PUBLIC_) ---
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# --- Pruebas ---
TEST_BASE_URL=http://localhost:3000
