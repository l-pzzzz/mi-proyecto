import { dirname } from "node:path";
import { fileURLToPath } from "node:url";
import { FlatCompat } from "@eslint/eslintrc";

const compat = new FlatCompat({
  baseDirectory: dirname(fileURLToPath(import.meta.url)),
});

export default [
  ...compat.extends("next/core-web-vitals", "next/typescript"),
  {
    ignores: [".next/**", "node_modules/**", "coverage/**", "playwright-report/**"],
  },
  {
    rules: {
      // Reglas que atrapan errores, no estilo. El estilo lo arregla Prettier.
      "no-console": ["error", { allow: ["warn", "error"] }],
      "@typescript-eslint/no-explicit-any": "error",
      "@typescript-eslint/no-floating-promises": "off", // requiere type-aware linting
      "@typescript-eslint/no-unused-vars": [
        "error",
        { argsIgnorePattern: "^_", varsIgnorePattern: "^_" },
      ],
      eqeqeq: ["error", "always", { null: "ignore" }],
      "no-restricted-syntax": [
        "error",
        {
          // Atrapa el fallo numero 4 de la guia de seguridad.
          selector:
            "MemberExpression[object.object.name='process'][object.property.name='env'] > Identifier[name=/^NEXT_PUBLIC_.*(SECRET|SERVICE|PRIVATE|TOKEN|PASSWORD)/]",
          message:
            "Una variable NEXT_PUBLIC_ viaja al navegador. Nunca pongas un secreto ahi.",
        },
      ],
    },
  },
];
